# Google OAuth (server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT used for the login session cookie
JWT_SECRET=replace-with-a-long-random-secret

# Local development
PORT=3000
NODE_ENV=development
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
APP_URL=http://localhost:3000

# Optional: Vite client-side Google OAuth client id, if your UI needs it
# VITE_GOOGLE_CLIENT_ID=

# Production example:
# GOOGLE_CALLBACK_URL=https://YOUR-RENDER-DOMAIN.onrender.com/api/auth/google/callback
# APP_URL=https://YOUR-RENDER-DOMAIN.onrender.com
